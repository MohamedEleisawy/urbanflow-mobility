# =============================================================================
# UrbanFlow Mobility — variables d'environnement (modèle)
# =============================================================================
# Copiez ce fichier vers `.env` et renseignez les valeurs réelles.
# Le fichier `.env` n'est JAMAIS versionné (voir .gitignore).
# Aucune valeur ci-dessous n'est un secret : ce sont des exemples.
# =============================================================================

# ----------------------------- Général --------------------------------------
NODE_ENV=development

# ----------------------------- Frontend (Next.js) ---------------------------
# Préfixe NEXT_PUBLIC_ = exposé au navigateur : n'y mettre aucun secret.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ----------------------------- Backend (NestJS) -----------------------------
PORT=3001
CARBON_SERVICE_URL=http://localhost:8000

# Fournisseur de géocodage (Phase 3A). FACULTATIF : sans lui, l'API se replie
# sur l'instance publique de Nominatim.
# ⚠️ AUCUN SECRET ICI : l'instance publique n'exige aucune clé. Si vous passez
# un jour à un fournisseur qui en demande une, elle reste côté SERVEUR —
# jamais dans une variable NEXT_PUBLIC_*.
GEOCODING_URL=https://nominatim.openstreetmap.org

# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (CORS).
# Plusieurs valeurs séparées par des virgules. Jamais `*`.
FRONTEND_URL=http://localhost:3000

# Flux GTFS-Realtime du réseau exploité, lu par `npm run gtfs-rt:import`.
# Public, donc pas un secret. Aucune valeur par défaut dans le code : sans
# cette variable ni argument, l'import s'arrête avec un message explicite.
GTFS_RT_URL=https://exemple-operateur.fr/gtfs-rt/alerts.pb

# ----------------------------- Base de données (PostgreSQL + PostGIS) -------
# Utilisées par docker-compose pour créer le conteneur Postgres.
# Identifiants de développement uniquement — jamais utilisés en production.
POSTGRES_USER=urbanflow
POSTGRES_PASSWORD=urbanflow_dev_password
POSTGRES_DB=urbanflow_dev

# Utilisée par Prisma (backend). Voir aussi projet/backend/.env.example.
DATABASE_URL=postgresql://urbanflow:urbanflow_dev_password@localhost:5432/urbanflow_dev?schema=public

# Secret de signature des JWT (authentification). Valeur d'exemple
# UNIQUEMENT : générez la vôtre en local avec `openssl rand -hex 32`.
JWT_SECRET=changez-moi-en-local-avec-openssl-rand-hex-32

# ----------------------------- Carbon service (FastAPI) ---------------------
CARBON_ENVIRONMENT=development
CARBON_HOST=0.0.0.0
CARBON_PORT=8000

# Racine des flux GBFS de Velib' Metropole (Phase 5).
# Public, sans cle. Le backend se replie sur cette meme adresse si absente.
# (remplacee par BIKE_GBFS_URL ci-dessous ; VELIB_GBFS_URL reste acceptee)

# ---------- Territoire de demonstration (Phase 6) ----------
# UrbanFlow est une plateforme GENERIQUE de mobilite urbaine. Ces variables,
# et elles seules, disent quel territoire cette installation dessert : le
# moteur d'itineraires, le calcul carbone et l'import GTFS restent
# entierement agnostiques.
#
# Defaut : l'Eurometropole de Strasbourg (~510 000 habitants), dont les
# donnees de mobilite sont reellement ouvertes.
TERRITORY_NAME=strasbourg
TERRITORY_DISPLAY_NAME=Eurometropole de Strasbourg
TERRITORY_COUNTRY=FR
TERRITORY_CENTER_LAT=48.5834
TERRITORY_CENTER_LON=7.7452
TERRITORY_RADIUS_M=12000

# Flux GTFS statique du reseau. Public, sans cle.
# CTS Strasbourg : https://opendata.cts-strasbourg.eu/google_transit.zip
GTFS_STATIC_URL=https://opendata.cts-strasbourg.eu/google_transit.zip

# Racine des flux GBFS du service de velos en libre-service. Public, sans cle.
# Velhop Strasbourg (nextbike), licence CC0-1.0.
BIKE_GBFS_URL=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_ae/fr
