// =============================================================================
// UrbanFlow Mobility — schéma Prisma (étape 2A : modèle de domaine de base)
// =============================================================================
// Ce fichier traduit en tables PostgreSQL le diagramme de classes du dossier
// de conception (dossier/diagrammes/03_class_domain.puml). Il ne contient que
// des données : les méthodes du diagramme (calculateEcoScore(), anonymize()...)
// sont de la logique métier et seront écrites dans des services NestJS, pas ici.
//
// Décisions non explicitement tranchées par le diagramme, prises pour cette
// étape et documentées à chaque endroit concerné :
//   - GeoPoint (latitude/longitude) est aplati en colonnes Float directement
//     sur Route et Stop, plutôt qu'en colonne géométrie PostGIS. PostGIS reste
//     activé dans la base pour les futures requêtes spatiales en SQL brut.
//   - AlertSeverity (référencé mais non défini dans le diagramme) reprend les
//     niveaux standards de GTFS-Realtime Service Alerts (INFO/WARNING/SEVERE).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RoleEnum {
  USER
  ADMIN
}

enum ThemeEnum {
  LIGHT
  DARK
  SYSTEM
}

/// Langues de l'interface.
///
/// ⚠️ `ES` AJOUTÉ EN PHASE 5, et c'est la SEULE raison de cette migration.
/// Le dossier de conception ne nomme que le français ; l'anglais existait
/// déjà. L'espagnol est demandé par le cahier des charges du sprint final.
///
/// Une valeur d'enum PostgreSQL ne peut pas être ajoutée par une simple mise
/// à jour de données : il faut un `ALTER TYPE`. C'est donc l'un des rares cas
/// où une migration est réellement nécessaire, et non un confort.
///
/// Les DTO n'ont RIEN à changer : ils valident par `@IsEnum(LanguageEnum)`,
/// qui suit le schéma.
enum LanguageEnum {
  FR
  EN
  ES
}

/// Type d'adresse favorite (bloc 7).
///
/// DEUX VALEURS, ET C'EST VOULU. Le dossier nomme exactement celles-ci :
/// « mémoriser des adresses favorites (Domicile, Travail) » (§3.2.1).
///
/// Un troisième cas « OTHER » aurait entraîné trois décisions qu'aucune
/// source ne tranche : un libellé libre à valider, une limite maximale à
/// justifier, et une unicité PARTIELLE que Prisma ne sait pas exprimer
/// (« unique seulement si type ≠ OTHER » demanderait un index SQL brut).
///
/// Avec deux valeurs, la limite de deux adresses par compte n'est pas une
/// règle arbitraire posée dans le code : elle découle de `@@unique`.
enum FavoriteAddressType {
  HOME
  WORK
}

enum ModeTransport {
  WALK
  BUS
  TRAM
  METRO
  /// Transport FERROVIAIRE — RER, Transilien (GTFS route_type = 2).
  ///
  /// ⚠️ Ajouté parce que le flux réel d'Île-de-France Mobilités contient 24
  /// lignes de ce type, jusque-là REJETÉES à l'import faute d'équivalent.
  /// Les faire passer pour du METRO aurait été un mensonge : un RER n'a ni
  /// la même desserte, ni la même vitesse, ni le même exploitant.
  ///
  /// Le facteur d'émission retenu est celui du dossier pour le rail
  /// électrique — 4 g/km, la valeur qu'il donne déjà au tram et au métro.
  /// Ce n'est pas une invention : c'est l'application de sa propre
  /// convention à un mode de même nature.
  TRAIN
  BIKE
  ESCOOTER
  CAR
}

enum AlertSeverity {
  INFO
  WARNING
  SEVERE
}

// -----------------------------------------------------------------------------
// Utilisateur
// -----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         RoleEnum  @default(USER)
  createdAt    DateTime  @default(now())
  // Suppression logique (RGPD) : jamais de DELETE physique sur ce compte.
  deletedAt    DateTime?

  preferences   UserPreferences?
  addresses     FavoriteAddress[]
  carbonRecords CarbonRecord[]
  carbonBudgets CarbonBudget[]
  routes        Route[]

  // Demandes de réinitialisation de mot de passe (war room).
  passwordResets PasswordResetToken[]

  @@map("users")
}

model UserPreferences {
  id                   String          @id @default(uuid()) @db.Uuid
  preferredModes       ModeTransport[]
  pmrMode              Boolean         @default(false)
  co2BudgetWeekly      Float
  notificationsEnabled Boolean         @default(true)
  language             LanguageEnum    @default(FR)
  theme                ThemeEnum       @default(SYSTEM)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @db.Uuid

  @@map("user_preferences")
}

/// Adresse favorite d'un usager (bloc 7).
///
/// Le dossier la place dans l'espace personnel : « Gérer ses préférences :
/// Permet de mémoriser des adresses favorites (Domicile, Travail) ou de
/// définir un mode de transport privilégié pour accélérer les recherches. »
///
/// ═══ UNE TABLE À PART, PAS DEUX COLONNES DANS UserPreferences ═══
///
/// Coller `domicileLat`, `domicileLng`, `domicileAdresse`, `travailLat`… dans
/// les préférences aurait fait six colonnes nullables décrivant deux choses
/// de même nature. Une table les décrit une fois.
///
/// ═══ RELIÉE DIRECTEMENT À User ═══
///
/// Une adresse est une DONNÉE PERSONNELLE — la plus sensible du projet, sans
/// doute : elle dit où quelqu'un habite. Elle appartient donc au compte, pas
/// aux préférences, et l'ownership se lit sur cette table sans jointure.
///
/// `onDelete: Cascade` comme les quatre autres relations de `User`. Il ne se
/// déclenche JAMAIS en pratique : la suppression de compte est LOGIQUE
/// (étape 5G), aucune ligne n'est détruite. Le cascade n'existe que pour le
/// jour où une suppression physique serait décidée — et il évite alors une
/// ligne orpheline pointant vers un compte disparu.
model FavoriteAddress {
  id String @id @default(uuid()) @db.Uuid

  type FavoriteAddressType

  /// Adresse telle que l'usager l'a saisie — « 12 rue des Lilas, Paris ».
  ///
  /// AUCUN GÉOCODAGE : le projet n'appelle aucun service d'adresses, et en
  /// inventer un ici ajouterait une dépendance externe hors périmètre. Le
  /// texte et les coordonnées sont donc saisis ensemble, et conservés
  /// exactement tels qu'envoyés.
  address String

  /// Coordonnées, mêmes bornes que partout ailleurs : [-90, 90] et
  /// [-180, 180], vérifiées par `@IsLatitude` / `@IsLongitude` au DTO.
  latitude  Float
  longitude Float

  /// Seule date du modèle. `User.createdAt` est le précédent du schéma, et
  /// l'export RGPD a besoin de dire QUAND une donnée a été enregistrée.
  ///
  /// Pas d'`updatedAt` : aucun modèle du projet n'en porte, et personne ne
  /// lirait celui-ci. Une colonne sans lecteur est une colonne à maintenir.
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  /// UN SEUL DOMICILE ET UN SEUL TRAVAIL PAR COMPTE.
  ///
  /// La contrainte vit dans la BASE, pas seulement dans le service : deux
  /// requêtes simultanées ne peuvent pas créer deux domiciles en se croisant
  /// entre le `findFirst` et le `create`. C'est aussi ce qui plafonne le
  /// nombre d'adresses à deux, sans compteur à écrire nulle part.
  @@unique([userId, type])
  @@map("favorite_addresses")
}

// -----------------------------------------------------------------------------
// Mobilité — itinéraires
// -----------------------------------------------------------------------------

model Route {
  id String @id @default(uuid()) @db.Uuid

  // GeoPoint "origin" aplati (voir décision en tête de fichier).
  originLat      Float
  originLng      Float
  // GeoPoint "destination" aplati.
  destinationLat Float
  destinationLng Float

  requestedAt      DateTime @default(now())
  totalDurationMin Int
  totalDistanceM   Int
  // 0 = voiture individuelle, 100 = mobilité douce (cf. note du diagramme).
  ecoScore         Float
  carbonEstimate   Float

  /// Mode d'un trajet DIRECT (boutons « À pied » / « À vélo » de la recherche).
  ///
  /// `null`        = trajet multimodal ordinaire, entièrement décrit par ses
  ///                 `segments` (le cas de tous les trajets jusqu'ici).
  /// `WALK`/`BIKE` = trajet d'une seule pièce, SANS aucun `Segment` : il
  ///                 n'emprunte aucune liaison du réseau, il va d'un bout à
  ///                 l'autre. Sa distance et sa durée sont recalculées par le
  ///                 serveur (routeur si disponible, sinon vol d'oiseau),
  ///                 jamais reprises du client.
  ///
  /// ⚠️ NULLABLE, sans reprise des lignes existantes : un trajet enregistré
  /// avant cette colonne reste `null` et se comporte exactement comme avant.
  mode ModeTransport?

  // Usager qui a enregistré cet itinéraire dans son historique.
  //
  // NULLABLE volontairement : le diagramme de cas d'utilisation place
  // "UC01 Rechercher un itinéraire" dans le bloc "Mobilité (Libre accès)",
  // donc un visiteur non connecté doit pouvoir obtenir un itinéraire. Dans
  // ce cas la route n'appartient à personne (userId = null).
  //
  // Le diagramme de classes ne reliait User à Route qu'indirectement
  // (User -> CarbonRecord -> Route). Ce lien direct a été ajouté à l'étape
  // 4A car il est indispensable à l'historique personnel décrit dans le
  // dossier ("Historique : les utilisateurs authentifiés peuvent
  // enregistrer leur trajet et consulter leur historique").
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.Uuid

  segments      Segment[]
  carbonRecords CarbonRecord[]

  @@map("routes")
}

model Segment {
  id            String        @id @default(uuid()) @db.Uuid
  mode          ModeTransport
  operator      String
  departureTime DateTime
  arrivalTime   DateTime
  distanceM     Int
  line          String

  /// Identifiant du trajet dans le flux GTFS (trips.txt, colonne trip_id).
  ///
  /// NULLABLE depuis l'étape 4E-1, et c'est une décision de fond.
  ///
  /// Un `Trip` GTFS est un PASSAGE PRÉCIS : le bus de 8 h 12, un jour donné.
  /// Notre `NetworkLink`, lui, est un AGRÉGAT : il résume tous les passages
  /// d'une ligne entre deux arrêts, et sa durée est leur MÉDIANE (étape
  /// 4C-4-4). Un itinéraire calculé sur ce réseau ne correspond donc à aucun
  /// passage en particulier — il n'existe aucun `trip_id` à lui attribuer.
  ///
  /// En fabriquer un serait inventer une donnée, exactement ce que nous
  /// avons refusé de faire pour le facteur d'émission d'ESCOOTER (4D-1).
  /// Le champ reste renseigné quand la donnée existe vraiment ; il vaut
  /// NULL quand elle n'existe pas.
  gtfsTripId String?

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String @db.Uuid

  // Deux relations distinctes vers Stop (from / to) : chacune doit être nommée
  // pour que Prisma sache laquelle est laquelle.
  fromStop   Stop   @relation("SegmentFromStop", fields: [fromStopId], references: [id])
  fromStopId String @db.Uuid

  toStop   Stop   @relation("SegmentToStop", fields: [toStopId], references: [id])
  toStopId String @db.Uuid

  @@map("segments")
}

model Stop {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // GeoPoint "location" aplati (voir décision en tête de fichier).
  latitude  Float
  longitude Float

  pmrAccessible Boolean @default(false)
  operatorCode  String

  /// Identifiant de l'arrêt dans le flux GTFS (stops.txt, colonne stop_id).
  ///
  /// NULLABLE : les arrêts du jeu de démonstration ne viennent pas de GTFS,
  /// et un arrêt pourra toujours être créé à la main.
  ///
  /// UNIQUE : c'est la clé qui rendra l'import IDEMPOTENT. Réimporter le
  /// même flux mettra à jour l'arrêt existant au lieu d'en créer un second.
  /// Notre `id` interne reste un UUID : on ne dépend donc jamais du format
  /// d'identifiant d'un opérateur, qui varie d'un réseau à l'autre.
  gtfsStopId String? @unique

  segmentsFrom Segment[] @relation("SegmentFromStop")
  segmentsTo   Segment[] @relation("SegmentToStop")

  // Liaisons du réseau public partant de cet arrêt / y arrivant (étape 4C-3).
  linksFrom NetworkLink[] @relation("LinkFromStop")
  linksTo   NetworkLink[] @relation("LinkToStop")

  // Passages théoriques à cet arrêt (sprint soutenance).
  departures StopDeparture[] @relation("StopDepartures")

  @@map("stops")
}

// -----------------------------------------------------------------------------
// Réseau de transport public (étape 4C-3)
// -----------------------------------------------------------------------------

/// Une ligne de transport : "Métro 4", "Bus 38" (étape 4C-4-1).
///
/// Correspond à une ligne du fichier GTFS routes.txt. Attention au piège de
/// vocabulaire : GTFS appelle "route" ce que nous appelons une LIGNE, alors
/// que notre modèle `Route` désigne l'itinéraire personnel d'un usager.
/// D'où le nom `TransitLine`, qui lève toute ambiguïté.
///
/// Pourquoi une table séparée plutôt que trois colonnes sur NetworkLink ?
///   - une ligne dessert PLUSIEURS liaisons : répéter son nom, son mode et
///     son opérateur sur chaque tronçon serait de la duplication ;
///   - GTFS fournit les lignes dans un fichier distinct : une table par
///     concept rend l'import direct et lisible ;
///   - renommer une ligne ne demandera qu'une seule mise à jour.
model TransitLine {
  id String @id @default(uuid()) @db.Uuid

  /// Identifiant de la ligne dans le flux GTFS (routes.txt, route_id).
  /// Nullable et unique, pour les mêmes raisons que Stop.gtfsStopId.
  gtfsRouteId String? @unique

  /// Nom affiché de la ligne. À l'import, il viendra de route_short_name
  /// (ex : "4"), avec route_long_name en repli si le premier est absent.
  name String

  /// Mode de transport de la ligne, déduit du route_type GTFS à l'import.
  mode ModeTransport

  /// Exploitant de la ligne (agency.txt).
  operator String

  links      NetworkLink[]
  departures StopDeparture[]

  @@map("transit_lines")
}

/// Une liaison du réseau public : "la ligne X relie l'arrêt A à l'arrêt B".
///
/// C'est l'ARÊTE du graphe utilisé par la recherche publique d'itinéraires
/// (POST /api/routes/search), dont les SOMMETS sont les Stop.
///
/// À ne pas confondre avec Segment, malgré leur ressemblance :
///
///   Segment      = une OCCURRENCE : "j'ai pris le bus 12 le 15/08 à 8h00".
///                  Appartient à une Route, donc à un usager.
///                  Porte des horaires absolus (departureTime/arrivalTime).
///
///   NetworkLink  = une RÈGLE : "le bus 12 relie A à B en 10 minutes".
///                  N'appartient à PERSONNE : aucune colonne userId.
///                  Porte une durée typique (durationMin).
///
/// C'est cette absence de propriétaire qui garantit, par construction, que la
/// recherche publique ne peut divulguer aucune donnée personnelle : on ne peut
/// pas divulguer ce qu'on ne stocke pas.
///
/// Le dossier de conception distingue explicitement (§3.1.3) les "données
/// métiers spatiales" (arrêts, lignes, itinéraires du réseau) des "données
/// utilisateurs". Cette table matérialise cette séparation.
///
/// Alimentée pour l'instant par un jeu de démonstration (prisma/seed.ts) ;
/// elle le sera par l'import GTFS à l'étape suivante.
model NetworkLink {
  id String @id @default(uuid()) @db.Uuid

  // Le mode, le nom et l'exploitant ne sont plus stockés ici depuis
  // l'étape 4C-4-1 : ils appartiennent à la ligne, pas au tronçon.
  line   TransitLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId String      @db.Uuid

  // Durée TYPIQUE de la liaison, en minutes — et non deux horaires absolus.
  // C'est précisément ce qui distingue une règle de réseau d'un trajet vécu.
  // À l'import GTFS, ce sera la MÉDIANE des durées observées sur ce tronçon.
  durationMin Int
  distanceM   Int

  fromStop   Stop   @relation("LinkFromStop", fields: [fromStopId], references: [id], onDelete: Cascade)
  fromStopId String @db.Uuid

  toStop   Stop   @relation("LinkToStop", fields: [toStopId], references: [id], onDelete: Cascade)
  toStopId String @db.Uuid

  /// Tracé RÉEL de la voie entre les deux arrêts, en GeoJSON LineString.
  ///
  /// ═══ D'OÙ VIENT CETTE GÉOMÉTRIE ═══
  ///
  /// De `shapes.txt` du flux GTFS de l'opérateur — jamais d'une
  /// interpolation. Le trajet complet d'une ligne y est décrit point par
  /// point ; la portion retenue ici est celle comprise entre les deux arrêts
  /// de cette liaison.
  ///
  /// ⚠️ `null` est une valeur LÉGITIME : un flux GTFS n'est pas tenu de
  /// fournir `shapes.txt`, et le jeu de démonstration n'en a pas. L'interface
  /// retombe alors honnêtement sur un tracé arrêt → arrêt, en le disant.
  ///
  /// ═══ POURQUOI `Json` ET NON PostGIS `geometry` ═══
  ///
  /// PostGIS est installé, et `geometry(LineString, 4326)` serait le choix
  /// canonique. Il a été écarté pour ce bloc : Prisma ne type pas `geometry`
  /// nativement — il faudrait `Unsupported()` et du SQL brut sur une lecture
  /// fréquente — alors qu'AUCUNE requête spatiale n'est nécessaire ici. Les
  /// phases carte et GPS ne font que DESSINER une ligne, et Leaflet consomme
  /// du GeoJSON tel quel.
  ///
  /// PostGIS redeviendra le bon choix le jour où une question spatiale se
  /// posera : « quelles lignes traversent ce rectangle ? ».
  ///
  /// ⚠️ ORDRE DES COORDONNÉES : GeoJSON impose [longitude, latitude] —
  /// l'inverse de l'usage courant et de Leaflet. Une inversion placerait
  /// Paris en Somalie sans lever la moindre erreur : un test la verrouille.
  geometry Json?

  /// Une ligne ne relie un arrêt A à un arrêt B qu'UNE SEULE FOIS.
  ///
  /// C'est la contrainte qui portera l'idempotence de l'import : les
  /// dizaines de trajets quotidiens d'une même ligne sur le tronçon A→B
  /// produiront une seule liaison, et non un doublon par passage.
  ///
  /// Deux LIGNES différentes reliant A à B restent bien deux liaisons
  /// distinctes, puisque lineId fait partie de la clé.
  @@unique([lineId, fromStopId, toStopId])
  @@map("network_links")
}

// -----------------------------------------------------------------------------
// Empreinte carbone
// -----------------------------------------------------------------------------

model CarbonRecord {
  id              String        @id @default(uuid()) @db.Uuid
  date            DateTime      @default(now())
  co2Grams        Float
  mode            ModeTransport
  distanceM       Int
  savedVsCarGrams Float

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  routeId String @db.Uuid

  @@map("carbon_records")
}

model CarbonBudget {
  id                  String @id @default(uuid()) @db.Uuid
  year                Int
  week                Int
  weeklyBudgetGrams   Float
  consumedWeeklyGrams Float  @default(0)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  // Le diagramme relie CarbonBudget à CarbonRecord ("aggregates") sans lister
  // de clé étrangère sur CarbonRecord pour cette relation : elle sera donc
  // calculée par requête (userId + année/semaine) plutôt que par une colonne
  // absente du diagramme.
  //
  // La contrainte d'unicité ci-dessous garantit un seul budget par usager et
  // par semaine — non explicite dans le diagramme, mais nécessaire au sens
  // même de "budget hebdomadaire".
  @@unique([userId, year, week])
  @@map("carbon_budgets")
}

// -----------------------------------------------------------------------------
// Perturbations (flux GTFS-Realtime)
// -----------------------------------------------------------------------------

model Alert {
  id String @id @default(uuid()) @db.Uuid

  // Le diagramme modélise stopIds/lineIds comme de simples listes
  // d'identifiants GTFS, pas comme des clés étrangères vers Stop : on les
  // stocke donc en tableaux de texte natifs PostgreSQL, sans relation formelle.
  stopIds String[]
  lineIds String[]

  affectedMode ModeTransport
  severity     AlertSeverity
  cause        String
  effect       String
  startTime    DateTime

  /// Fin de la période d'activité de l'alerte.
  ///
  /// NULLABLE depuis l'étape 4F-1A, et c'est une nécessité, pas un confort.
  ///
  /// GTFS-Realtime décrit la validité d'une alerte par un `active_period`
  /// dont le champ `end` est FACULTATIF :
  ///
  ///     active_period { start: 1735689600 }        ← aucune fin annoncée
  ///
  /// C'est le cas courant d'une perturbation dont on ignore la durée : une
  /// panne, une grève, des travaux sans date de reprise. Exiger une fin
  /// obligerait à en inventer une — une date lointaine arbitraire — que rien
  /// ne distinguerait ensuite d'une vraie échéance annoncée par l'opérateur.
  ///
  /// C'est le même refus qu'aux étapes 4D-1 (aucun facteur d'émission inventé
  /// pour ESCOOTER) et 4E-1 (aucun `gtfsTripId` fabriqué) : NULL dit la
  /// vérité — « cette information n'existe pas » — là où une valeur par
  /// défaut mentirait.
  endTime DateTime?

  /// Titre de la perturbation, tel que publié par l'opérateur.
  ///
  /// AJOUTÉ À L'ÉTAPE 4F-2A, et pour une raison fonctionnelle précise. Le
  /// dossier décrit UC02 comme « affiche la liste des alertes en cours sur le
  /// réseau (retards, pannes, travaux) POUR INFORMER LES VOYAGEURS ».
  ///
  /// Or le modèle ne portait jusqu'ici que des valeurs techniques : cause,
  /// effect, severity, identifiants GTFS. Une alerte s'y résumait à
  /// « MAINTENANCE / REDUCED_SERVICE » — exploitable par une machine,
  /// illisible pour un voyageur. GTFS-Realtime transporte pourtant le texte
  /// rédigé par l'opérateur (`header_text`), que l'import décodait sans
  /// pouvoir l'écrire, faute de colonne.
  ///
  /// NULLABLE : un flux peut ne publier aucun texte, ou n'en publier que
  /// dans une langue qu'on ne sait pas choisir. NULL dit alors « aucun texte
  /// n'a été fourni » — la même réponse honnête qu'`endTime` (4F-1A),
  /// `gtfsTripId` (4E-1) ou le facteur d'`ESCOOTER` (4D-1). Le contraire
  /// reviendrait à fabriquer une phrase à partir de `cause` et `effect`, donc
  /// à faire passer notre interprétation pour la parole de l'opérateur.
  headerText String?

  /// Description détaillée de la perturbation (`description_text`).
  ///
  /// Nullable pour les mêmes raisons que `headerText`, et indépendamment de
  /// lui : un opérateur publie couramment un titre sans description.
  descriptionText String?

  gtfsAlertId String @unique

  @@map("alerts")
}

// -----------------------------------------------------------------------------
// Calendrier de service et horaires de passage (sprint soutenance)
// -----------------------------------------------------------------------------
// ═══ LE MENSONGE QUE CES TROIS TABLES SUPPRIMENT ═══
//
// Jusqu'ici, le modèle ne connaissait que des DURÉES TYPIQUES : « le tram D
// relie Gare Centrale à Homme de Fer en 4 minutes ». C'était une règle de
// réseau, sans aucune notion de temps.
//
// Deux conséquences, toutes deux visibles à l'écran :
//
//   1. La durée annoncée EXCLUAIT L'ATTENTE. « 12 min » pour un trajet qui en
//      demande 20 un dimanche soir, parce que le bus passe toutes les heures.
//
//   2. Les lignes de NUIT étaient proposées EN PLEIN JOUR. Le graphe ne savait
//      pas que leur service n'était pas actif : la ligne existait, donc elle
//      était empruntable. Un usager envoyé à 14 h vers un arrêt desservi
//      uniquement entre 0 h 30 et 5 h aurait attendu longtemps.
//
// ═══ POURQUOI CES DONNÉES NE VONT PAS DANS `NetworkLink` ═══
//
// `NetworkLink` est une RÈGLE, sans propriétaire ni horaire — c'est ce qui
// garantit qu'aucune donnée personnelle ne peut fuiter par la recherche
// publique. Y ajouter 710 000 horaires détruirait à la fois son unicité
// `(lineId, fromStopId, toStopId)` et sa lisibilité.
//
// `StopDeparture` est donc une table SÉPARÉE et, comme `NetworkLink`, sans
// aucune colonne `userId` : elle décrit le réseau, jamais quelqu'un.
// -----------------------------------------------------------------------------

/// Un service au sens GTFS : « du lundi au vendredi, du 31/08 au 26/02 ».
///
/// Correspond à une ligne de `calendar.txt`. Le flux de la CTS en publie 78 —
/// semaine, samedi, dimanche, vacances scolaires, jours fériés.
model TransitService {
  id String @id @default(uuid()) @db.Uuid

  /// `service_id` du flux, PRÉFIXÉ par le code exploitant.
  ///
  /// ⚠️ LE PRÉFIXE N'EST PAS DÉCORATIF. Deux réseaux importés côte à côte
  /// publient des `service_id` qui se ressemblent (« Semaine », « 1 ») ;
  /// sans préfixe, l'import du second écraserait les services du premier.
  /// C'est la même convention que `gtfsStopId` et `gtfsRouteId`.
  gtfsServiceId String @unique

  /// Jours de la semaine desservis, du lundi au dimanche.
  ///
  /// SEPT BOOLÉENS ET NON UN MASQUE BINAIRE : `monday` se lit dans une
  /// requête SQL et dans une inspection de base ; `days & 1` ne se lit nulle
  /// part. Le gain d'octets serait de six par ligne, sur 78 lignes.
  monday    Boolean
  tuesday   Boolean
  wednesday Boolean
  thursday  Boolean
  friday    Boolean
  saturday  Boolean
  sunday    Boolean

  /// Période de validité, bornes INCLUSES (c'est la règle GTFS).
  ///
  /// `@db.Date` et non `DateTime` complet : un service commence un JOUR, pas
  /// à un instant. Stocker une heure inviterait un décalage de fuseau à
  /// faire basculer une date d'un jour.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  exceptions TransitServiceException[]
  departures StopDeparture[]

  @@map("transit_services")
}

/// Une exception au calendrier : jour férié retiré, dimanche exceptionnel
/// ajouté. Correspond à `calendar_dates.txt`.
///
/// ⚠️ SANS ELLES, LE CALENDRIER EST FAUX LES JOURS OÙ ÇA COMPTE LE PLUS.
/// Le 1er mai, le 25 décembre, le 14 juillet : précisément les jours où un
/// usager vérifie ses horaires. Le flux de la CTS en publie 1 071.
model TransitServiceException {
  id String @id @default(uuid()) @db.Uuid

  service   TransitService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String         @db.Uuid

  date DateTime @db.Date

  /// `true` = service ajouté ce jour-là (exception_type 1)
  /// `false` = service retiré ce jour-là (exception_type 2)
  ///
  /// UN BOOLÉEN ET NON L'ENTIER GTFS : « added » se comprend sans la
  /// spécification sous les yeux, « exceptionType: 2 » non.
  added Boolean

  /// Une exception par service et par date : réimporter le flux met à jour
  /// au lieu d'empiler.
  @@unique([serviceId, date])
  @@map("transit_service_exceptions")
}

/// Un passage théorique : « la ligne D part de Homme de Fer à 08:42, les
/// jours où le service Semaine est actif ».
///
/// Correspond à une ligne de `stop_times.txt`, jointe à son `trip`.
///
/// ═══ POURQUOI ON NE STOCKE QUE LE DÉPART ═══
///
/// `stop_times.txt` porte une heure d'arrivée ET une heure de départ. Elles
/// sont identiques sur l'immense majorité des arrêts urbains, et seule
/// l'heure de DÉPART répond à la question posée : « dans combien de temps
/// puis-je monter ? ». Stocker les deux doublerait le volume pour rien.
model StopDeparture {
  id String @id @default(uuid()) @db.Uuid

  line   TransitLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  lineId String      @db.Uuid

  stop   Stop   @relation("StopDepartures", fields: [stopId], references: [id], onDelete: Cascade)
  stopId String @db.Uuid

  service   TransitService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId String         @db.Uuid

  /// Heure de départ, en SECONDES DEPUIS MINUIT du jour de service.
  ///
  /// ⚠️ PEUT DÉPASSER 86 400, ET CE N'EST PAS UNE ERREUR. GTFS écrit
  /// « 25:10:00 » pour un passage à 1 h 10 du matin appartenant encore au
  /// service de la veille — c'est ainsi qu'un service de nuit reste d'un
  /// seul tenant. Un `@db.Time` refuserait la valeur ; un entier l'accepte
  /// et rend l'arithmétique triviale.
  departureSec Int

  /// Destination affichée en girouette (`trip_headsign`), quand le flux la
  /// donne. C'est ce qui distingue les deux sens d'une même ligne à l'écran.
  headsign String?

  /// L'index qui porte la requête « prochains passages à cet arrêt ».
  ///
  /// `(stopId, departureSec)` et non `(stopId)` seul : la requête filtre sur
  /// l'arrêt PUIS ordonne par heure. Sans la seconde colonne, PostgreSQL
  /// trierait en mémoire les quelques centaines de passages quotidiens d'un
  /// arrêt — à chaque appel.
  @@index([stopId, departureSec])
  /// L'index qui porte l'IDEMPOTENCE DE L'IMPORT.
  ///
  /// ⚠️ AJOUTÉ APRÈS UN TIMEOUT DE TEST, et l'oubli valait cher. Chaque import
  /// commence par `deleteMany({ where: { lineId: { in: … } } })` — supprimer
  /// les passages des lignes qu'on s'apprête à réécrire. Sans index sur
  /// `lineId`, PostgreSQL balaie les 710 302 lignes de la table à chaque
  /// import, et un réimport de vérification dépassait trente secondes.
  ///
  /// La lenteur ne se voyait pas sur le premier import — la table était vide.
  /// Elle n'apparaissait qu'au SECOND, c'est-à-dire exactement dans le test
  /// d'idempotence.
  @@index([lineId])
  /// L'index qui porte la recherche « quelles lignes circulent maintenant ».
  ///
  /// `lignesActives()` filtre sur `serviceId` puis sur une fenêtre horaire.
  /// C'est la requête que le moteur d'itinéraires lance à CHAQUE recherche.
  @@index([serviceId, departureSec])
  @@map("stop_departures")
}

// -----------------------------------------------------------------------------
// Réinitialisation de mot de passe (war room)
// -----------------------------------------------------------------------------
/// Un jeton de réinitialisation, à usage unique et à durée courte.
///
/// ═══ CE QUI EST STOCKÉ, ET CE QUI NE L'EST PAS ═══
///
/// ⚠️ LE JETON N'EST PAS STOCKÉ. Seule son EMPREINTE l'est. Un jeton de
/// réinitialisation vaut un mot de passe : quiconque lit la base pourrait
/// sinon prendre la main sur n'importe quel compte ayant une demande en cours.
///
/// L'empreinte est un SHA-256 nu, et c'est délibérément différent des mots de
/// passe, qui passent par scrypt. La raison tient à ce que chaque secret
/// protège :
///
///   - un MOT DE PASSE est choisi par un humain, donc devinable : il faut un
///     hachage LENT pour rendre une attaque par dictionnaire impraticable ;
///   - un JETON fait 32 octets tirés d'un générateur cryptographique. Aucun
///     dictionnaire n'existe pour cela, et un hachage lent ne protégerait de
///     rien tout en ralentissant chaque vérification.
///
/// ═══ POURQUOI UNE TABLE, ET NON DEUX COLONNES SUR `User` ═══
///
/// Deux colonnes suffiraient pour UNE demande. Une table permet de garder la
/// trace des demandes consommées, donc de refuser un jeton déjà utilisé au
/// lieu de l'accepter parce que la colonne a été écrasée par une demande plus
/// récente.
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @db.Uuid

  /// SHA-256 hexadécimal du jeton envoyé à l'usager.
  ///
  /// UNIQUE : c'est par cette empreinte qu'on retrouve la demande. Un index
  /// est donc indispensable — la vérification a lieu à chaque tentative.
  tokenHash String @unique

  expiresAt DateTime

  /// Instant de consommation. `null` = jeton encore utilisable.
  ///
  /// ⚠️ ON MARQUE PLUTÔT QUE DE SUPPRIMER. Un jeton supprimé et un jeton
  /// inexistant deviendraient indiscernables : impossible alors de distinguer
  /// « déjà utilisé » de « jamais émis », et impossible de constater qu'un
  /// jeton a servi deux fois.
  usedAt DateTime?

  createdAt DateTime @default(now())

  /// Retrouver toutes les demandes d'un compte, pour les invalider en bloc
  /// dès qu'une nouvelle est émise.
  @@index([userId])
  @@map("password_reset_tokens")
}
