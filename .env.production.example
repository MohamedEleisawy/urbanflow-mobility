# =============================================================================
# UrbanFlow Mobility — variables de PRODUCTION (modèle)
# =============================================================================
# Copiez ce fichier en `.env.production` SUR LE SERVEUR UNIQUEMENT, puis
# remplissez les valeurs. `.env.production` est ignoré par git (`.env.*`) :
# il ne doit JAMAIS être poussé sur GitHub.
#
#   cp .env.production.example .env.production
#   nano .env.production
#   chmod 600 .env.production          # lisible par vous seul
#
# Lancement :
#   docker compose --env-file .env.production -f docker-compose.production.yml up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données
# -----------------------------------------------------------------------------
POSTGRES_USER=urbanflow
# ⚠️ CHANGEZ CETTE VALEUR. Générez-la, ne l'inventez pas :
#     openssl rand -base64 24
POSTGRES_PASSWORD=PFo1koAbxTG6kWAxj1vP/H8NEA/EIhBe
POSTGRES_DB=urbanflow

# -----------------------------------------------------------------------------
# Secret de signature des JWT
# -----------------------------------------------------------------------------
# ⚠️ UN SECRET NEUF, JAMAIS CELUI DU DÉVELOPPEMENT. Celui de votre poste a pu
# transiter par des journaux, des sauvegardes, un partage d'écran. Générez :
#     openssl rand -hex 32
JWT_SECRET=REMPLACEZ_MOI_PAR_UN_SECRET_DE_64_CARACTERES_HEXA

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (CORS).
# Plusieurs valeurs se séparent par des virgules, SANS espace :
#   FRONTEND_URL=https://urbanflow.vercel.app,https://www.urbanflow.fr
# ⚠️ JAMAIS `*` : ce serait autoriser n'importe quel site à appeler l'API avec
# la session d'un usager connecté.
FRONTEND_URL=https://votre-projet.vercel.app

# Adresse publique utilisée pour construire le lien de réinitialisation de mot
# de passe. C'est le site que reçoit l'usager, donc le frontend — pas l'API.
APP_PUBLIC_URL=https://votre-projet.vercel.app

# -----------------------------------------------------------------------------
# HTTPS (uniquement si vous utilisez docker-compose.caddy.yml)
# -----------------------------------------------------------------------------
# Domaine de l'API, servi en HTTPS par Caddy avec un certificat Let's Encrypt
# obtenu et renouvelé automatiquement.
#
# ⚠️ L'enregistrement DNS de ce domaine doit pointer vers l'IP du serveur AVANT
# le premier démarrage : sans cela, Let's Encrypt ne peut pas vérifier que le
# domaine vous appartient, et Caddy boucle sur l'obtention du certificat.
#
# Laissez cette ligne commentée si vous n'utilisez pas encore Caddy.
# API_DOMAIN=api.mon-domaine.fr

# -----------------------------------------------------------------------------
# Recherche d'adresses
# -----------------------------------------------------------------------------
# Instance publique de Nominatim : gratuite, sans clé, plafonnée à une requête
# par seconde. Pour un usage soutenu, hébergez votre propre instance et
# remplacez simplement cette adresse.
GEOCODING_URL=https://nominatim.openstreetmap.org

# -----------------------------------------------------------------------------
# Territoire desservi
# -----------------------------------------------------------------------------
# Ces sept variables, et elles seules, disent quelle métropole cette
# installation dessert : centre de carte, bornage du géocodage, libellé affiché.
TERRITORY_NAME=strasbourg
TERRITORY_DISPLAY_NAME=Strasbourg et Eurometropole
TERRITORY_COUNTRY=FR
# Place Kléber.
TERRITORY_CENTER_LAT=48.5834
TERRITORY_CENTER_LON=7.7452
# ~15 km : de Vendenheim au nord à Illkirch-Graffenstaden au sud.
TERRITORY_RADIUS_M=15000
# ⚠️ INDISPENSABLE AUX HORAIRES. Un horaire GTFS est en heure LOCALE du réseau ;
# sans ce fuseau, un serveur en UTC annoncerait des passages déjà partis.
TERRITORY_TIMEZONE=Europe/Paris

# -----------------------------------------------------------------------------
# Vélos en libre-service
# -----------------------------------------------------------------------------
# ⚠️ CETTE URL A ÉTÉ VÉRIFIÉE, ET C'EST UNE VÉRIFICATION QUI COMPTE. Un flux
# GBFS d'une AUTRE ville répondrait parfaitement — code 200, données valides —
# mais pour des stations situées à des centaines de kilomètres. Aucune erreur
# ne serait levée : la carte afficherait simplement zéro station.
#
# Contrôle effectué sur ce flux :
#   system_information.name     = « Vélhop - Strasbourg »
#   system_information.operator = « Strasbourg Mobilités Vélo, 67000 Strasbourg »
#   licence                     = CC0-1.0
#   40 stations, toutes à moins de 11 km de Place Kléber, aucune hors zone.
#
# Pour revérifier après un changement d'URL :
#   curl -s <URL>/system_information.json | grep -i name
BIKE_GBFS_URL=https://gbfs.nextbike.net/maps/gbfs/v2/nextbike_ae/fr

# -----------------------------------------------------------------------------
# Routage rue par rue — piéton ET vélo
# -----------------------------------------------------------------------------
# Valhalla, instance publique de la communauté OpenStreetMap : gratuite, sans
# clé. Profils `pedestrian` (trottoirs, traversées, escaliers) et `bicycle`
# (pistes cyclables, contresens autorisés, pente). Deux capacités DISTINCTES :
# `GET /api/capabilities` publie `walkRouting` et `bikeRouting` séparément.
#
# ✅ CES QUATRE VARIABLES ONT UN DÉFAUT dans `docker-compose.production.yml`
# (`${VAR:-valhalla}` / `${VAR:-https://valhalla1.openstreetmap.de}`) : même
# ABSENTES de ce fichier, le routage rue par rue reste ACTIF. Ne les renseignez
# ici QUE pour pointer votre propre instance Valhalla.
#
# ⚠️ DÉPENDANCE EXTÉRIEURE DÉGRADÉE PROPREMENT. Si Valhalla est lent, en panne
# ou injoignable, l'application NE TOMBE PAS : marche et vélo retombent sur une
# estimation à vol d'oiseau, l'interface l'annonce (« estimation », « Itinéraire
# vélo estimé », tracé en pointillés), et un disjoncteur cesse d'interroger le
# moteur une minute. Le backend journalise l'état au démarrage
# (« Routage vélo ACTIF / NON CONFIGURÉ »).
#
# ⚠️ SANS RAPPORT AVEC VÉLHOP : renseigner `BIKE_GBFS_URL` n'active pas le
# routage vélo.
#
#   WALK_ROUTING_PROVIDER=valhalla
#   WALK_ROUTING_BASE_URL=https://valhalla1.openstreetmap.de
#   BIKE_ROUTING_PROVIDER=valhalla
#   BIKE_ROUTING_BASE_URL=https://valhalla1.openstreetmap.de

# -----------------------------------------------------------------------------
# Identité légale (RGPD)
# -----------------------------------------------------------------------------
# ⚠️ AUCUNE VALEUR N'EST INVENTÉE ICI. Un nom de société ou une adresse
# fabriqués sur une page « Mentions légales » ne seraient pas du remplissage :
# ce seraient de fausses coordonnées de responsable de traitement.
#
# Laissées vides, les pages légales affichent un encadré indiquant qu'il s'agit
# d'une installation de démonstration. C'est la réponse honnête pour un projet
# d'études.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
PRIVACY_CONTACT_EMAIL=
